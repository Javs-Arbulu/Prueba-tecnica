# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the resulting .env (see .gitignore).
# docker compose reads this file; every value below has a safe local default.
# ---------------------------------------------------------------------------

# Which settings module to load: config.settings.local | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO

# Postgres (the values are also consumed by the `db` service in docker-compose)
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=support
DATABASE_URL=postgres://support:support@db:5432/support

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Rate limits (DRF syntax: <number>/<second|minute|hour|day>)
THROTTLE_PUBLIC_CREATE=20/hour
THROTTLE_PUBLIC_READ=120/hour
THROTTLE_AUTH_TOKEN=10/min
# Per reported email, on top of the per-IP limit above
THROTTLE_PUBLIC_EMAIL=5/hour

# How many proxies sit in front of this process. 0 means "there are none, so
# identify clients by REMOTE_ADDR". Behind a load balancer set it to the real
# number, or every client shares one rate-limit bucket. Never leave it unset:
# DRF then trusts X-Forwarded-For, and anyone can invent one.
NUM_PROXIES=0

# Largest request body accepted, in bytes. No endpoint takes uploads.
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576

# Refuse to boot on a per-process cache. Throttle counters live in the cache, so
# a local one multiplies every limit by the number of workers. True in production.
REQUIRE_SHARED_CACHE=False

# Duplicate-submission windows for the public intake (ADR-15)
PUBLIC_TICKET_DEDUPE_WINDOW_SECONDS=60
IDEMPOTENCY_KEY_WINDOW_SECONDS=86400

# Run migrations + seed the demo dataset on container start
RUN_MIGRATIONS=true
SEED_DEMO=true

# Password used by every user created by `manage.py seed_demo` (demo only)
DEMO_PASSWORD=demo12345

# Frontend origin allowed by CORS (only needed if the optional React client runs)
CORS_ALLOWED_ORIGINS=http://localhost:5173
